        "required": ["ebl_document_id", "ebl_document_hash", "carrier_imo_number", "vessel_name", "mineral_type", "gross_weight_metric_tons", "port_of_loading_code", "port_of_discharge_code", "shipper_name", "consignee_name"]
      }
