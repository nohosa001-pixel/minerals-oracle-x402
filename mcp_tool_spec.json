        "type": "object",
        "properties": {
          "mineral_type": {"type": "string", "description": "Optional filter by mineral"},
          "origin_country": {"type": "string", "description": "Optional origin country code"},
          "destination_country": {"type": "string", "description": "Optional destination country code"}
        }
      }
    },
