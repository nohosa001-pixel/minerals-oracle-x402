# Minerals Oracle & x402 Gateway Configuration

# [필수] 결제 수신용 Base/Ethereum 지갑 주소 (공개 주소)
ORACLE_TREASURY_WALLET=0xYourBaseWalletAddressHere

# [보안] 테스트용 우회 헤더 허용 여부 (프로덕션에서는 반드시 false)
ALLOW_DEV_BYPASS=false

# [네트워크 설정] Base Mainnet Chain ID (Base: 8453, Base Sepolia: 84532)
BASE_CHAIN_ID=8453

# [결제 금액] 쿼리당 부과할 USDC 금액
DEFAULT_PRICE_USDC=0.005

# [x402 Facilitator 엔드포인트]
X402_FACILITATOR_URL=https://facilitator.base.org/v1/verify
