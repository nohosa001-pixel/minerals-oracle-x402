# Minerals Oracle & x402 Gateway Configuration

# [필수] 결제 수신용 Polygon/Ethereum 지갑 주소 (공개 주소)
ORACLE_TREASURY_WALLET=0x255F9991233f86B29dB847c8d5b8CB9915e80dCf

# [보안] 테스트용 우회 헤더 허용 여부 (프로덕션에서는 반드시 false)
ALLOW_DEV_BYPASS=false

# [네트워크 설정] Polygon Mainnet Chain ID (Polygon: 137, Polygon Amoy: 80002)
POLYGON_CHAIN_ID=137
CHAIN_ID=137

# [결제 금액] 쿼리당 부과할 USDC 금액
DEFAULT_PRICE_USDC=0.005

# [x402 Facilitator 엔드포인트]
X402_FACILITATOR_URL=https://facilitator.polygon.technology/v1/verify

# [X (Twitter) Alpha Bot Configuration] (Optional - enables live tweet broadcasting)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# [Telegram Smartphone Alert Bot Configuration] (Optional - enables real-time push alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DIGEST_INTERVAL_MIN=5
TELEGRAM_DIGEST_INTERVAL_SEC=300.0

# [Korea Investment & Securities (한투 KIS Developers) API Configuration]
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_CANO=
KIS_ACNT_PRDT_CD=01
KIS_FUTURES_ACNT_PRDT_CD=08
KIS_ACCOUNT_NO=
KIS_FUTURES_ACCOUNT_NO=

# [Overseas Futures & ETF Automated Trade Sizing Configuration]
# TRADE_MODE: FUTURES_MICRO (마이크로선물), FUTURES_STANDARD (표준선물), ETF (해외ETF), AUTO (자본금 기준 자동선택)
TRADE_MODE=AUTO
# TRADE_SIZING_MODE: CAPITAL_BASED (자본금비례), FIXED_LOTS (지정 계약수), DYNAMIC_KELLY (켈리 복리)
TRADE_SIZING_MODE=CAPITAL_BASED
FIXED_LOT_QUANTITY=1
TOTAL_CAPITAL_USD=1000.0
TRADE_SIZE_USD=300.0
MARGIN_SAFETY_BUFFER_PCT=20.0
MIN_SPREAD_BPS=50.0
SCAN_INTERVAL_SEC=5.0
KIS_DRY_RUN=true
TARGET_COMMODITY=ALL
ENABLE_CLOUD_BOT=false
MAX_POSITIONS=4
